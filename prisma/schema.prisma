generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pokemon {
  id           Int                  @id
  apiName      String               @unique
  height       Int
  weight       Int
  sprite       String?
  generation   Int?
  stats        PokemonStats?
  translations PokemonTranslation[]
  types        PokemonType[]
  moves        PokemonMove[]
  abilities    PokemonAbility[]
  favoritedBy  Favorite[]
}

model PokemonTranslation {
  id          Int     @id @default(autoincrement())
  pokemonId   Int
  language    String
  name        String
  description String?
  genus       String?
  pokemon     Pokemon @relation(fields: [pokemonId], references: [id])

  @@unique([pokemonId, language])
}

model PokemonStats {
  pokemonId      Int     @id
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int
  specialDefense Int
  speed          Int
  pokemon        Pokemon @relation(fields: [pokemonId], references: [id])
}

model Type {
  id      Int    @id
  apiName String @unique

  translations TypeTranslation[]

  pokemon PokemonType[]
  moves   Move[]
}

model TypeTranslation {
  id Int @id @default(autoincrement())

  typeId Int

  language String

  name String

  type Type @relation(fields: [typeId], references: [id])

  @@unique([typeId, language])
}

model PokemonType {
  pokemonId Int
  typeId    Int
  slot      Int?

  pokemon Pokemon @relation(fields: [pokemonId], references: [id])
  type    Type    @relation(fields: [typeId], references: [id])

  @@id([pokemonId, typeId])
}

model Move {
  id           Int               @id
  apiName      String            @unique
  typeId       Int
  power        Int?
  accuracy     Int?
  pp           Int?
  damageClass  String?
  priority     Int?
  effectChance Int?
  effect       String?
  translations MoveTranslation[]
  type         Type              @relation(fields: [typeId], references: [id])
  learnedBy    PokemonMove[]
}

model MoveTranslation {
  id          Int     @id @default(autoincrement())
  moveId      Int
  language    String
  name        String
  description String?
  move        Move    @relation(fields: [moveId], references: [id])

  @@unique([moveId, language])
}

model PokemonMove {
  pokemonId Int
  moveId    Int

  learnMethod String?
  level       Int?

  pokemon Pokemon @relation(fields: [pokemonId], references: [id])

  move Move @relation(fields: [moveId], references: [id])

  @@id([pokemonId, moveId])
}

model Ability {
  id           Int                  @id
  apiName      String               @unique
  effect       String?
  translations AbilityTranslation[]
  pokemon      PokemonAbility[]
}

model AbilityTranslation {
  id          Int     @id @default(autoincrement())
  abilityId   Int
  language    String
  name        String
  description String?
  ability     Ability @relation(fields: [abilityId], references: [id])

  @@unique([abilityId, language])
}

model PokemonAbility {
  pokemonId Int
  abilityId Int

  isHidden Boolean @default(false)
  slot     Int?

  pokemon Pokemon @relation(fields: [pokemonId], references: [id])
  ability Ability @relation(fields: [abilityId], references: [id])

  @@id([pokemonId, abilityId])
}

model item {
  id           Int               @id
  apiName      String            @unique
  cost         Int?
  flingPower   Int?
  flingEffect  String?
  category     String?
  effect       String?
  sprite       String?
  translations ItemTranslation[]
  berry        Berry?
}

model ItemTranslation {
  id          Int     @id @default(autoincrement())
  itemId      Int
  language    String
  name        String
  description String?
  item        item    @relation(fields: [itemId], references: [id])

  @@unique([itemId, language])
}

model Berry {
  id               Int           @id
  apiName          String        @unique
  itemId           Int?          @unique
  growthTime       Int?
  maxHarvest       Int?
  naturalGiftPower Int?
  naturalGiftType  String?
  size             Int?
  smoothness       Int?
  soilDryness      Int?
  firmness         String?
  item             item?         @relation(fields: [itemId], references: [id])
  flavors          BerryFlavor[]
}

model BerryFlavor {
  id      Int    @id @default(autoincrement())
  berryId Int
  flavor  String
  potency Int
  berry   Berry  @relation(fields: [berryId], references: [id])

  @@unique([berryId, flavor])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String  @map("user_id")
  type                     String
  provider                 String
  providerAccountId        String  @map("provider_account_id")
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  // GitHub liefert dieses Feld seit der Refresh-Token-Rotation zusätzlich mit; NextAuth reicht es unverändert durch.
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // bcrypt-Hash für den Credentials-Login; null bei reinen OAuth-Konten (z.B. GitHub).
  password      String?
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]

  @@map("users")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  pokemonId Int      @map("pokemon_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@unique([userId, pokemonId])
  @@map("favorites")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserFavorites {
  id Int @id @default(autoincrement())
}
